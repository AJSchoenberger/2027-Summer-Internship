    // --- APPLICATION TRACKER KANBAN ---
    function renderKanbanBoard() {
      const board = document.getElementById('kanban-board');
      const stages = ['Discovered', 'Saved', 'Preparing', 'Ready to Apply', 'Applied'];

      board.innerHTML = stages.map(stage => {
        const stageJobs = state.jobs.filter(j => j.status === stage || (stage === 'Discovered' && !j.status));
