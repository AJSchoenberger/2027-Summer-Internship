      const company = document.getElementById('custom-company').value || 'Custom Firm';
      const title = document.getElementById('custom-title').value || 'Summer 2027 Wealth Intern';
      const category = document.getElementById('custom-category').value;
      const description = document.getElementById('custom-description').value;

      const newJob = {
        id: 'job-' + Date.now(),
        company,
        title,
        category,
        location: 'New York, NY',
        arrangement: 'Hybrid',
        deadline: '2026-12-15',
