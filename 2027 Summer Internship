          <div class="job-score-box">
            <div class="score-badge">
              <div class="score-number ${job.matchScore < 90 ? 'med' : ''}">${job.matchScore}%</div>
              <div class="score-label">Match Score</div>
            </div>
            <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); startTailoringForJob('${job.id}')">Tailor Resume</button>
          </div>
        </div>
      `).join('');
    }

    // --- MODAL & DETAIL HANDLERS ---
    function openJobDetail(jobId) {
      const job = state.jobs.find(j => j.id === jobId);
      if (!job) return;
      state.activeJobId = jobId;

      document.getElementById('modal-job-title').innerText = job.title;
      document.getElementById('modal-job-company').innerText = `${job.company} | ${job.location} | Deadline: ${job.deadline}`;
      document.getElementById('modal-job-description').innerText = job.description;

      document.getElementById('modal-score-breakdown').innerHTML = `
        <div class="breakdown-item"><span class="breakdown-title">Career Alignment (30%)</span><span class="breakdown-val text-green">${job.scoreBreakdown.career}</span></div>
        <div class="breakdown-item"><span class="breakdown-title">Skills Match (25%)</span><span class="breakdown-val text-green">${job.scoreBreakdown.skills}</span></div>
        <div class="breakdown-item"><span class="breakdown-title">Graduation Year (15%)</span><span class="breakdown-val text-green">${job.scoreBreakdown.edu}</span></div>
        <div class="breakdown-item"><span class="breakdown-title">Location Pref (10%)</span><span class="breakdown-val">${job.scoreBreakdown.loc}</span></div>
        <div class="breakdown-item"><span class="breakdown-title">Work Auth (10%)</span><span class="breakdown-val text-green">${job.scoreBreakdown.auth}</span></div>
      `;

      document.getElementById('modal-job-keywords').innerHTML = job.keywords.map(kw => `<span class="tag tag-priority">${kw}</span>`).join('');

      openModal('job-detail-modal');
    }

    function openModal(modalId) {
      document.getElementById(modalId).classList.add('active');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }

