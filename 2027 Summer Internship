<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Internship Copilot | Summer 2027 Finance & Wealth Management</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #0b0f19;
      --bg-card: #131b2e;
      --bg-card-hover: #1c2742;
      --bg-input: #182238;
      --border: #233152;
      --border-focus: #3b82f6;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --accent-gold: #d97706;
      --accent-gold-bg: rgba(217, 119, 6, 0.15);
      --success: #10b981;
      --success-bg: rgba(16, 185, 129, 0.15);
      --warning: #f59e0b;
      --warning-bg: rgba(245, 158, 11, 0.15);
      --danger: #ef4444;
      --danger-bg: rgba(239, 68, 68, 0.15);
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Nav Header */
    header {
      background: rgba(19, 27, 46, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 0.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .brand-icon {
      background: linear-gradient(135deg, #2563eb, #1d4ed8, #d97706);
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1rem;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .nav-tabs {
      display: flex;
      gap: 0.5rem;
      background: rgba(11, 15, 25, 0.6);
      padding: 0.25rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .nav-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.05);
    }

    .nav-btn.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.4);
    }

    .user-badge {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--bg-card);
      padding: 0.4rem 0.8rem;
      border-radius: 9999px;
      border: 1px solid var(--border);
      font-size: 0.8rem;
    }

    .user-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--accent-gold);
      color: #000;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }

    /* Main Container Layout */
    .app-container {
      flex: 1;
      padding: 2rem;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
    }

    .view-panel {
      display: none;
      animation: fadeIn 0.25s ease-in-out forwards;
    }

    .view-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Dashboard Layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 1.5rem;
    }

    /* Filter Sidebar */
    .sidebar-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      height: fit-content;
      position: sticky;
      top: 5rem;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .filter-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .form-control, .form-select {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.6rem 0.8rem;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.875rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--border-focus);
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"] {
      accent-color: var(--primary);
    }

    /* Job Feed Section */
    .feed-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .feed-title {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s;
    }

    .btn:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-main);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    .btn-outline-gold {
      background: transparent;
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
    }

    .btn-outline-gold:hover {
      background: var(--accent-gold-bg);
    }

    .btn-sm {
      padding: 0.35rem 0.7rem;
      font-size: 0.775rem;
    }

    .jobs-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .job-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      display: grid;
      grid-template-columns: 1fr 140px;
      gap: 1rem;
      transition: all 0.2s ease;
      cursor: pointer;
      position: relative;
    }

    .job-card:hover {
      border-color: #3b82f6;
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .job-card.featured {
      border-left: 4px solid var(--accent-gold);
    }

    .job-main-info {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .company-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .company-name {
      font-weight: 700;
      color: var(--text-main);
    }

    .job-role-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
    }

    .tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .tag {
      font-size: 0.725rem;
      font-weight: 600;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .tag.tag-priority {
      background: var(--accent-gold-bg);
      color: #fbbf24;
      border-color: rgba(217, 119, 6, 0.4);
    }

    .job-score-box {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: space-between;
    }

    .score-badge {
      text-align: right;
    }

    .score-number {
      font-size: 1.75rem;
      font-weight: 800;
      line-height: 1;
      color: var(--success);
    }

    .score-number.med {
      color: var(--warning);
    }

    .score-label {
      font-size: 0.675rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-dim);
      font-weight: 700;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 900px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
    }

    .modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: var(--bg-card);
      z-index: 10;
    }

    .modal-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .modal-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      background: var(--bg-card);
    }

    /* Score Breakdown Section */
    .breakdown-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.75rem;
      background: rgba(11, 15, 25, 0.5);
      padding: 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .breakdown-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .breakdown-title {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .breakdown-val {
      font-weight: 700;
      font-size: 0.95rem;
    }

    /* Fact Bank Verification UI */
    .fact-bank-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .fact-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .fact-card.verified {
      border-left: 4px solid var(--success);
    }

    .fact-card.unverified {
      border-left: 4px solid var(--warning);
    }

    .badge-status {
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .badge-verified {
      background: var(--success-bg);
      color: var(--success);
    }

    .badge-unverified {
      background: var(--warning-bg);
      color: var(--warning);
    }

    /* Side-by-side Tailoring View */
    .tailor-comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .resume-pane {
      background: #0b0f19;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      font-family: serif;
      color: #e2e8f0;
      line-height: 1.6;
      font-size: 0.9rem;
    }

    .resume-header-preview {
      text-align: center;
      border-bottom: 1px solid #334155;
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
      font-family: var(--font-sans);
    }

    .bullet-highlight {
      background: rgba(16, 185, 129, 0.15);
      border-left: 3px solid var(--success);
      padding: 0.2rem 0.4rem;
      margin-bottom: 0.4rem;
      border-radius: 2px;
      font-family: var(--font-sans);
      font-size: 0.85rem;
    }

    .bullet-flagged {
      background: rgba(239, 68, 68, 0.15);
      border-left: 3px solid var(--danger);
      padding: 0.2rem 0.4rem;
      margin-bottom: 0.4rem;
      border-radius: 2px;
      font-family: var(--font-sans);
      font-size: 0.85rem;
    }

    /* Pipeline Kanban Tracker */
    .kanban-board {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 1rem;
    }

    .kanban-column {
      background: rgba(19, 27, 46, 0.6);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      min-width: 220px;
    }

    .kanban-header {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .kanban-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .kanban-card-title {
      font-size: 0.875rem;
      font-weight: 700;
    }

    .kanban-card-company {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Extension Preview Bar */
    .extension-banner {
      background: linear-gradient(90deg, #1d4ed8, #4f46e5);
      border-radius: var(--radius-md);
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .ext-title {
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Utility Helpers */
    .flex-row { display: flex; align-items: center; gap: 0.5rem; }
    .text-sm { font-size: 0.85rem; color: var(--text-muted); }
    .text-gold { color: var(--accent-gold); }
    .text-green { color: var(--success); }
    .text-danger { color: var(--danger); }
    .mt-1 { margin-top: 0.5rem; }
    .mt-2 { margin-top: 1rem; }
  </style>
</head>
<body>

  <!-- Top Navigation Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">WM</div>
      <span>Internship Copilot</span>
      <span style="font-size: 0.7rem; background: var(--accent-gold-bg); color: var(--accent-gold); border: 1px solid rgba(217, 119, 6, 0.4); padding: 0.1rem 0.5rem; border-radius: 99px;">Summer 2027</span>
    </div>

    <nav class="nav-tabs">
      <button class="nav-btn active" onclick="switchTab('discovery')">Discovery Engine</button>
      <button class="nav-btn" onclick="switchTab('factbank')">Verified Fact Bank</button>
      <button class="nav-btn" onclick="switchTab('tailor')">Resume Tailor</button>
      <button class="nav-btn" onclick="switchTab('tracker')">Application Tracker</button>
      <button class="nav-btn" onclick="switchTab('extension')">Autofill Assistant</button>
    </nav>

    <div class="user-badge">
      <div class="user-avatar">JS</div>
      <div>
        <div style="font-weight: 700; line-height: 1;">Jordan Smith</div>
        <div style="font-size: 0.675rem; color: var(--text-dim);">Graduation: May 2028</div>
      </div>
    </div>
  </header>

  <main class="app-container">

    <!-- VIEW 1: INTERNSHIP DISCOVERY DASHBOARD -->
    <section id="view-discovery" class="view-panel active">
      <div class="dashboard-grid">
        
        <!-- Sidebar Filters -->
        <aside class="sidebar-card">
          <div class="card-title">
            <span>Target Filters</span>
            <button class="btn btn-secondary btn-sm" onclick="resetFilters()">Reset</button>
          </div>

          <div class="filter-group">
            <label class="filter-label">Search Keywords</label>
            <input type="text" id="filter-search" class="form-control" placeholder="Role title, firm, or skill..." oninput="renderJobs()">
          </div>

          <div class="filter-group">
            <label class="filter-label">Finance Sub-Sectors</label>
            <div class="checkbox-group">
              <label class="checkbox-label"><input type="checkbox" checked value="wm" onchange="renderJobs()"> Wealth Management (PWM)</label>
              <label class="checkbox-label"><input type="checkbox" checked value="am" onchange="renderJobs()"> Asset & Investment Mgmt</label>
              <label class="checkbox-label"><input type="checkbox" checked value="pb" onchange="renderJobs()"> Private Banking & Family Office</label>
              <label class="checkbox-label"><input type="checkbox" value="fp" onchange="renderJobs()"> Financial Planning / RIA</label>
              <label class="checkbox-label"><input type="checkbox" value="ib" onchange="renderJobs()"> Investment Banking / Markets</label>
            </div>
          </div>

          <div class="filter-group">
            <label class="filter-label">Work Arrangement</label>
            <select id="filter-location-type" class="form-select" onchange="renderJobs()">
              <option value="all">All Arrangements</option>
              <option value="Hybrid">Hybrid</option>
              <option value="On-site">On-site</option>
              <option value="Remote">Remote</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label">Min Match Score</label>
            <select id="filter-min-score" class="form-select" onchange="renderJobs()">
              <option value="0">Show All Listings</option>
              <option value="80">80%+ (High Alignment)</option>
              <option value="90">90%+ (Top Priority)</option>
            </select>
          </div>

          <div style="background: rgba(37, 99, 235, 0.1); border: 1px solid rgba(37, 99, 235, 0.3); padding: 0.8rem; border-radius: var(--radius-sm); font-size: 0.775rem; color: #bfdbfe;">
            💡 <strong>Hard Eligibility Rule:</strong> Pre-configured to target <strong>Summer 2027</strong> positions requiring May 2028 graduation.
          </div>
        </aside>

        <!-- Main Job List Feed -->
        <section>
          <div class="feed-header">
            <div>
              <h1 class="feed-title">Summer 2027 Wealth & Asset Management Roles</h1>
              <p class="text-sm">Real-time normalized feeds & custom entry options</p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button class="btn btn-secondary" onclick="openModal('add-job-modal')">+ Paste Job Description</button>
            </div>
          </div>

          <div id="jobs-container" class="jobs-list">
            <!-- Dynamically populated via JavaScript -->
          </div>
        </section>
      </div>
    </section>

    <!-- VIEW 2: VERIFIED FACT BANK & PROFILE -->
    <section id="view-factbank" class="view-panel">
      <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
        
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h2>Master Profile & Truth-Bank</h2>
            <p class="text-sm">Only verified facts can be injected by the AI into tailored résumés to guarantee 100% truthful claims.</p>
          </div>
          <button class="btn btn-secondary" onclick="triggerResumeUpload()">📤 Upload PDF / DOCX Resume</button>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem; border-radius: var(--radius-md); display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
          <div>
            <div class="filter-label">User Target</div>
            <div style="font-weight: 700;">Jordan Smith</div>
            <div class="text-sm">jordan.smith@university.edu</div>
          </div>
          <div>
            <div class="filter-label">Expected Graduation</div>
            <div style="font-weight: 700;">May 2028 (BS Finance)</div>
            <div class="text-sm">GPA: 3.82 / 4.00</div>
          </div>
          <div>
            <div class="filter-label">Fact Guardrail Status</div>
            <div style="font-weight: 700; color: var(--success);">14 Verified Facts Active</div>
            <div class="text-sm">0 Unverified Claims</div>
          </div>
        </div>

        <h3>Verified Fact Inventory</h3>
        <div id="fact-bank-list" class="fact-bank-container">
          <!-- Dynamically Populated -->
        </div>
      </div>
    </section>

    <!-- VIEW 3: TAILORED RESUME EDITOR -->
    <section id="view-tailor" class="view-panel">
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h2>Truth-Constrained Resume Tailoring Engine</h2>
            <p class="text-sm" id="tailor-subtitle">Selecting opportunity to align tailored bullets...</p>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn btn-secondary" onclick="runTruthCheck()">🔍 Run Automated Truth-Check</button>
            <button class="btn" onclick="exportPDF()">📄 Export ATS PDF</button>
            <button class="btn btn-outline-gold" onclick="exportDOCX()">📝 Export DOCX</button>
          </div>
        </div>

        <!-- Side-by-Side View -->
