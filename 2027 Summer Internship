    // --- NAVIGATION LOGIC ---
    function switchTab(tabId) {
      state.activeTab = tabId;
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.view-panel').forEach(panel => panel.classList.remove('active'));

      event.target.classList.add('active');
      const targetPanel = document.getElementById(`view-${tabId}`);
      if (targetPanel) targetPanel.classList.add('active');

      if (tabId === 'factbank') renderFactBank();
      if (tabId === 'tailor') renderTailoredResume();
      if (tabId === 'tracker') renderKanbanBoard();
    }

    // --- RENDER DISCOVERY FEED ---
    function renderJobs() {
      const container = document.getElementById('jobs-container');
      const searchTerm = document.getElementById('filter-search').value.toLowerCase();
      const arrangement = document.getElementById('filter-location-type').value;
      const minScore = parseInt(document.getElementById('filter-min-score').value, 10);

      // Filter sub-sectors checked
      const checkedCategories = Array.from(document.querySelectorAll('.checkbox-group input:checked')).map(cb => cb.value);

      const filtered = state.jobs.filter(job => {
        const matchesSearch = job.title.toLowerCase().includes(searchTerm) || job.company.toLowerCase().includes(searchTerm);
        const matchesArrangement = arrangement === 'all' || job.arrangement === arrangement;
        const matchesCategory = checkedCategories.includes(job.category);
        const matchesScore = job.matchScore >= minScore;
        return matchesSearch && matchesArrangement && matchesCategory && matchesScore;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding: 3rem; color: var(--text-muted); background: var(--bg-card); border-radius: var(--radius-md);">No opportunities matching criteria. Try adjusting your filters.</div>`;
        return;
      }

      container.innerHTML = filtered.map(job => `
        <div class="job-card ${job.featured ? 'featured' : ''}" onclick="openJobDetail('${job.id}')">
          <div class="job-main-info">
            <div class="company-row">
              <span class="company-name">${job.company}</span>
              <span>•</span>
              <span>${job.location} (${job.arrangement})</span>
              <span>•</span>
              <span style="color: var(--warning);">Deadline: ${job.deadline}</span>
            </div>
            <div class="job-role-title">${job.title}</div>
            <div class="tags-row">
